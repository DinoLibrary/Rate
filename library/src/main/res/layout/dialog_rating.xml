<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="12dp">

    <!-- Ultra Compact Modern Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/top_rate_wave_header" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/bottom_rate_wave_header"
                app:layout_constraintTop_toBottomOf="@id/imageView" />
            <ImageView
                android:id="@+id/dialog_rating_icon"
                android:layout_width="@dimen/_56sdp"
                app:layout_constraintTop_toBottomOf="@id/imageView"
                app:layout_constraintBottom_toBottomOf="@id/imageView"
                android:layout_height="@dimen/_56sdp"
                android:layout_gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:elevation="12dp"
                android:src="@drawable/rate_0" />

            <TextView
                android:id="@+id/dialog_rating_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/titanone_regular"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/imageView2"
                android:gravity="center"
                android:ellipsize="end"
                android:minLines="2"
                android:text="We are working hard for a better user experience."
                android:textColor="#0F172A"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/dialog_rating_content"
                android:layout_width="match_parent"
                app:layout_constraintTop_toBottomOf="@id/dialog_rating_title"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/baloo2_medium"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:ellipsize="end"
                android:minLines="1"
                android:text="We’d greatly appreciate it if you could rate us."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <com.willy.ratingbar.ScaleRatingBar
                android:id="@+id/dialog_rating_rating_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/dialog_rating_content"
                android:layout_gravity="center"
                android:paddingVertical="6dp"
                android:paddingHorizontal="4dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                app:srb_clearRatingEnabled="false"
                app:srb_clickable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:srb_drawableEmpty="@drawable/rate_star_empty"
                app:srb_drawableFilled="@drawable/rate_star_filled"
                app:srb_isIndicator="false"
                app:srb_minimumStars="0"
                app:srb_numStars="5"
                android:layout_marginHorizontal="20dp"
                app:srb_rating="0"
                app:srb_scrollable="true"
                app:srb_starHeight="34dp"
                app:srb_starPadding="6dp"
                app:srb_starWidth="34dp"
                app:srb_stepSize="1" />

            <ImageView
                android:id="@+id/arrow"
                android:layout_width="@dimen/_14sdp"
                android:layout_marginTop="4dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/star2"
                android:layout_toStartOf="@+id/star2"
                android:src="@drawable/rate_curved_arrow"
                android:layout_marginStart="4dp"
                android:rotation="-12"
                app:layout_constraintBottom_toTopOf="@+id/tv"
                app:layout_constraintStart_toEndOf="@+id/tv"
                app:layout_constraintTop_toBottomOf="@+id/dialog_rating_rating_bar" />

            <TextView
                android:id="@+id/tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dialog_rating_rating_bar"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/baloo2_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dialog_rating_rating_bar"
                android:gravity="center"
                android:text="The best we can get :)    "
                android:textColor="#0D9488"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rate_bg_button"
                android:drawableStart="@drawable/rate_star_white"
                android:drawablePadding="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:elevation="6dp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:stateListAnimator="@null"
                android:text="RATE US"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv" />

            <TextView
                android:id="@+id/btnLate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@id/btnRate"
                android:fontFamily="@font/baloo2_medium"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                android:padding="6dp"
                android:text="Maybe Later"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
