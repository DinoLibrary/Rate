<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp tạo độ dày/chiều sâu 3D (Shadow Layer) -->
    <item android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#E2E8F0" />
        </shape>
    </item>
    
    <!-- Bề mặt chính của thẻ (Main Body) -->
    <item android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Viền phản quang sáng bóng (Glass Highlight Edge) -->
    <item android:bottom="8dp" android:top="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#F8FAFC" />
        </shape>
    </item>
</layer-list>
