<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Soft Shadow -->
    <path
        android:pathData="M100,108 m-92,0 a92,92 0 1,1 184,0 a92,92 0 1,1 -184,0"
        android:fillColor="#22000000" />

    <!-- Main Face -->
    <path
        android:pathData="M100,100 m-90,0 a90,90 0 1,1 180,0 a90,90 0 1,1 -180,0">

        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="70"
                android:centerY="45"
                android:gradientRadius="150">

                <item
                    android:color="#FFFFF3A6"
                    android:offset="0" />

                <item
                    android:color="#FFFFD54F"
                    android:offset="0.55" />

                <item
                    android:color="#FFFFB300"
                    android:offset="1" />

            </gradient>
        </aapt:attr>
    </path>

    <!-- Gloss Highlight -->
    <path
        android:pathData="M35,40 C60,10 130,5 165,45 C135,20 75,22 35,40 Z">

        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="100"
                android:startY="15"
                android:endX="100"
                android:endY="55">

                <item
                    android:color="#88FFFFFF"
                    android:offset="0" />

                <item
                    android:color="#00FFFFFF"
                    android:offset="1" />

            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Eyebrow -->
    <path
        android:pathData="M58,65 Q68,55 80,62"
        android:strokeColor="#4E342E"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- Right Eyebrow -->
    <path
        android:pathData="M120,62 Q132,55 142,65"
        android:strokeColor="#4E342E"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- Left Eye -->
    <path
        android:pathData="M68,88 a10,10 0 1,1 20,0 a10,10 0 1,1 -20,0"
        android:fillColor="#3E2723" />

    <!-- Right Eye -->
    <path
        android:pathData="M112,88 a10,10 0 1,1 20,0 a10,10 0 1,1 -20,0"
        android:fillColor="#3E2723" />

    <!-- Eye Shine -->
    <path
        android:pathData="M75,83 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0"
        android:fillColor="#FFFFFF"/>

    <path
        android:pathData="M119,83 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0"
        android:fillColor="#FFFFFF"/>

    <!-- Cute Smile -->
    <path
        android:pathData="M70,130 Q100,155 130,130"
        android:strokeColor="#4E342E"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- Blush Left -->
    <path
        android:pathData="M45,112 a14,8 0 1,1 28,0 a14,8 0 1,1 -28,0"
        android:fillColor="#22FF6F91"/>

    <!-- Blush Right -->
    <path
        android:pathData="M127,112 a14,8 0 1,1 28,0 a14,8 0 1,1 -28,0"
        android:fillColor="#22FF6F91"/>

</vector>